rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for staff authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Orders Collection
    match /orders/{orderId} {
      // Customers can create their new order
      allow create: if request.resource.data.orderId == orderId
                    && request.resource.data.player is string
                    && request.resource.data.package is string;

      // Customer can fetch single order document by orderId to track order status
      allow get: if true;

      // Only authenticated Staff can list all orders, filter, and view real-time feed
      allow list: if isAuthenticated();

      // Only Staff can change status, update notes, or archive/deliver orders
      allow update: if isAuthenticated();

      // Only Staff can delete orders
      allow delete: if isAuthenticated();
    }

    // Staff Applications Collection
    match /applications/{applicationId} {
      // Candidates can submit application
      allow create: if request.resource.data.id == applicationId
                    && request.resource.data.minecraftUsername is string;

      // Candidate can view their own application by ID
      allow get: if true;

      // Only Staff can list applications
      allow list: if isAuthenticated();

      // Only Staff can update application status or notes
      allow update: if isAuthenticated();

      // Only Staff can delete applications
      allow delete: if isAuthenticated();
    }

    // Users Collection (Profiles & Purchase counts)
    match /users/{userId} {
      // User can view their own profile or public profile badge
      allow get: if true;
      allow list: if isAuthenticated();

      // User can create or update their own profile and purchase count
      allow create, update: if (request.auth != null && request.auth.uid == userId) || isAuthenticated();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
