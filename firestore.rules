rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders Collection: Shared in realtime across all devices and dashboards
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Staff Applications Collection
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users Collection: Profiles and purchase counts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

